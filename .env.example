# ===== Aplikasi =====
NODE_ENV=development
# Development lokal. Untuk hosting (mis. Vercel), set ke URL publik aplikasi,
# contoh: https://nexterp.vercel.app. Bila tidak diset di Vercel, URL produksi
# dideteksi otomatis dari environment Vercel (VERCEL_PROJECT_PRODUCTION_URL).
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta

# ===== Database (Neon) =====
# Pooled (host mengandung "-pooler") untuk aplikasi
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct (tanpa "-pooler") khusus migrasi Drizzle Kit
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# ===== Secret Key (digunakan untuk enkripsi cookie) =====
BETTER_AUTH_SECRET=isi-hasil-perintah-di-atas

# ===== AI (opsional, diaktifkan di Tahap 9) =====
AI_ENABLED=false
GEMINI_API_KEY=
GROQ_API_KEY=

# ===== Observability (Tahap 10D) =====
# Level log terendah yang ditulis (debug | info | warn | error). Default: info.
LOG_LEVEL=info
# Reporter error eksternal. `none` = no-op (default). `sentry` memerlukan
# SDK Sentry dipasang terpisah (lihat docs/OPERATIONS.md §Error Tracking).
ERROR_REPORTER=none
SENTRY_DSN=